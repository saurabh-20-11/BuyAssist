# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# --- Jev / TypeSafe AI (java-backend, server-side only) ---
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_BASE_URL=https://api.typesafe.ai

# --- Gemini / Google Gen AI (java-backend, server-side only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- AP2 service (python, server-side only) ---
AP2_SERVICE_PORT=8081
# AP2 signing material / config as required by the official SDK

# --- Java backend ---
SERVER_PORT=8080
AP2_SERVICE_URL=http://localhost:8081

# --- Catalog source: "mock" (default) or "ebay" (live Browse API) ---
CATALOG_SOURCE=mock

# --- eBay Browse API (server-side only; needed only when CATALOG_SOURCE=ebay) ---
# Get these from https://developer.ebay.com -> your app's production keys.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
